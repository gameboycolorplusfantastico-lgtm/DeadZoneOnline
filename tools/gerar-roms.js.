const fs = require('fs'), path = require('path');
const ROOT = path.join(__dirname, '..', 'roms');
const OUT = path.join(ROOT, 'roms.json');
const EXT = {
  gba:['gba','agb'], nes:['nes','fds','unf','unif'], snes:['sfc','smc','fig','swc'], md:['md','gen','smd','bin']
};
const FOLDER = { gba:'gba', gameboyadvance:'gba', nes:'nes', snes:'snes', supernintendo:'snes', md:'md', megadrive:'md', genesis:'md' };
const ARCH = ['zip', '7z'];
const sysByExt = e => Object.keys(EXT).find(k => EXT[k].includes(e)) || '';

function walk(dir, base = ''){
  let out = [];
  for(const n of fs.readdirSync(dir, { withFileTypes:true })){
    const rel = base ? base + '/' + n.name : n.name;
    if(n.isDirectory()) out = out.concat(walk(path.join(dir, n.name), rel));
    else out.push(rel);
  }
  return out;
}
function titleOf(file){
  let n = path.posix.basename(file).replace(/\.(zip|7z)$/i, '').replace(/\.[^.]+$/, '');
  n = n.replace(/\s*[\(\[][^\)\]]*[\)\]]/g, '').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
  return n || path.posix.basename(file);
}
function systemOf(file){
  const parts = file.toLowerCase().split('/'), name = parts.pop(), bits = name.split('.');
  const ext = bits.pop();
  if(ARCH.includes(ext)){
    const inner = bits.pop() || '';
    if(sysByExt(inner)) return sysByExt(inner);
    for(const f of parts) if(FOLDER[f.replace(/[^a-z0-9]/g, '')]) return FOLDER[f.replace(/[^a-z0-9]/g, '')];
    return '';
  }
  return sysByExt(ext);
}

if(!fs.existsSync(ROOT)){ console.error('Pasta roms/ não encontrada.'); process.exit(1); }
let old = [];
try{ const j = JSON.parse(fs.readFileSync(OUT, 'utf8')); old = Array.isArray(j) ? j : (j.games || []); }catch(e){}
const prev = new Map(old.filter(x => x && x.file).map(x => [x.file, x]));

const all = EXT.gba.concat(EXT.nes, EXT.snes, EXT.md, ARCH);
const games = [];
for(const file of walk(ROOT).sort((a, b) => a.localeCompare(b))){
  const ext = file.split('.').pop().toLowerCase();
  if(!all.includes(ext)) continue;
  if(/^(readme|license|licenca|leia-?me)/i.test(path.posix.basename(file))) continue;
  const mine = prev.get(file) || {};
  const g = Object.assign({ file, title:titleOf(file), system:systemOf(file) }, mine);
  if(!g.system) console.warn('sem console definido: ' + file);
  games.push(g);
}
games.sort((a, b) => (a.system || '~').localeCompare(b.system || '~') || a.title.localeCompare(b.title));
fs.writeFileSync(OUT, JSON.stringify(games, null, 2) + '\n');
console.log('roms.json atualizado: ' + games.length + ' jogos');
